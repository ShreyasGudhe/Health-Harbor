# VitalPlunder Environment Configuration
# =======================================
# Copy this file to .env and fill in your values

# Flask Configuration
SECRET_KEY=your-super-secret-key-change-in-production
FLASK_DEBUG=True
PORT=5000

# Google Gemini API Key (for Ship Doctor module)
# Get your key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Database (PostgreSQL)
# Example (Neon): postgresql://user:password@host/db?sslmode=require
DATABASE_URL=
CAPTAINS_LOG_TABLE_NAME=captains_log_entries

# Firebase (optional – only needed for auth-protected routes)
# Point to your Firebase Admin SDK JSON (never commit the file)
# Example: D:/keys/health-harbor-admin.json
FIREBASE_CREDENTIALS_PATH=

# Tesseract OCR Path (Windows)
# Download from: https://github.com/UB-Mannheim/tesseract/wiki
TESSERACT_PATH=C:\Program Files\Tesseract-OCR\tesseract.exe

# File Upload Settings
MAX_CONTENT_LENGTH=16777216
UPLOAD_FOLDER=uploads
